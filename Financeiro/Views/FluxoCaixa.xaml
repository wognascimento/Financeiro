<UserControl x:Class="Financeiro.Views.FluxoCaixa"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Financeiro.Views"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="600" d:DesignWidth="1400">

    <UserControl.Resources>

        <Style x:Key="LabelComBorda" TargetType="Border">
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" BorderBrush="#CCC" BorderThickness="1" Padding="8">
            <StackPanel>

                <!-- Título -->
                <TextBlock Text="Movimentos futuros:"
                           Foreground="Red"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <!-- Linha 1 -->
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Empresa" VerticalAlignment="Center" />
                    <telerik:RadComboBox
                        ItemsSource="{Binding Empresas}" 
                        SelectedItem="{Binding SelectedEmpresa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        DisplayMemberPath="nome_empresa" 
                        SelectedValuePath="id_empresa" 
                        Grid.Column="1" />

                    <TextBlock Text="Conta" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center"/>
                    <telerik:RadComboBox
                        ItemsSource="{Binding Contas}" 
                            SelectedItem="{Binding SelectedConta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            DisplayMemberPath="conta"
                        Grid.Column="3"/>

                    <TextBlock Text="A partir de" Grid.Column="4" VerticalAlignment="Center" TextAlignment="Center"/>
                    <telerik:RadDatePicker 
                        SelectedValue="{Binding DataInicial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Grid.Column="5"/>


                    <TextBlock Text="Saldo Anterior:" Grid.Column="6" TextAlignment="Center"/>
                    <TextBlock Text="{Binding SaldoAnterior, StringFormat={}{0:C2}}" Foreground="Blue" Grid.Column="7" TextAlignment="Center"/>

                </Grid>

                <!-- Linha 2 -->
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="41"/>
                        <ColumnDefinition Width="159"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Limite" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Grid.ColumnSpan="2"/>

                    <TextBlock Text="Vencimento Limite" Grid.Column="3" TextAlignment="Center"/>
                    <TextBox Grid.Column="4"/>

                    <TextBlock Text="Até" Grid.Column="5" TextAlignment="Center"/>
                    <telerik:RadDatePicker 
                        SelectedValue="{Binding DataFinal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Grid.Column="6"/>

                    <TextBlock Text="Saldo:" Grid.Column="7" TextAlignment="Center"/>
                    <TextBlock Text="{Binding Saldo, StringFormat={}{0:C2}}" Grid.Column="8" TextAlignment="Center"/>

                </Grid>

                <!-- Linha 3 -->
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Agência"/>
                    <TextBox Grid.Column="1"/>

                    <TextBlock Text="N. Conta" Grid.Column="2" TextAlignment="Center"/>
                    <TextBox Grid.Column="3"/>
                </Grid>

            </StackPanel>
        </Border>

        <telerik:RadToolBar Grid.Row="1"
                            Margin="0,10,0,0"
                            GripVisibility="Collapsed"
                            OverflowButtonVisibility="Collapsed">
            <telerik:RadButton Content="Adicionar"
                               Click="OnAdicionarFluxoClick"
                               Padding="12,4"/>
        </telerik:RadToolBar>

        <!-- ================= GRID ================= -->
        <telerik:RadGridView x:Name="GridFluxo"
                             ItemsSource="{Binding Fluxos}"
                             SelectedItem="{Binding SelectedMovimentoFuturo}"
                             Grid.Row="2"
                             Margin="0,6,0,0"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             CanUserFreezeColumns="False"
                             CanUserInsertRows="True"
                             NewRowPosition="Top"
                             IsReadOnly="False"
                             IsFilteringAllowed="True"
                             AddingNewDataItem="GridFluxo_AddingNewDataItem"
                             CellValidating="GridFluxo_CellValidating"
                             RowValidating="GridFluxo_RowValidating"
                             RowIndicatorVisibility="Collapsed"
                             SelectionMode="Single"
                             SelectionUnit="FullRow">

            <telerik:RadGridView.Columns>

                <telerik:GridViewDataColumn Header="Conta"
                                            DataMemberBinding="{Binding conta}"
                                            Width="120">
                    <telerik:GridViewDataColumn.CellEditTemplate>
                        <DataTemplate>
                            <telerik:RadComboBox
                                ItemsSource="{Binding DataContext.ContasGrid, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                SelectedItem="{Binding conta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEditable="True"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellEditTemplate>
                </telerik:GridViewDataColumn>

                <telerik:GridViewDataColumn Header="Depto"
                                            DataMemberBinding="{Binding depto}"
                                            Width="100">
                    <telerik:GridViewDataColumn.CellEditTemplate>
                        <DataTemplate>
                            <telerik:RadComboBox
                                ItemsSource="{Binding DataContext.DepartamentosGrid, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                SelectedItem="{Binding depto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEditable="True"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellEditTemplate>
                </telerik:GridViewDataColumn>

                <telerik:GridViewDataColumn Header="Classif"
                                    DataMemberBinding="{Binding classif}"
                                    Width="110"/>

                <telerik:GridViewDataColumn Header="Class3"
                                    DataMemberBinding="{Binding class3}"
                                    Width="90"/>

                <telerik:GridViewDataColumn Header="F/V"
                                            DataMemberBinding="{Binding tipo}"
                                            Width="60">
                    <telerik:GridViewDataColumn.CellEditTemplate>
                        <DataTemplate>
                            <telerik:RadComboBox
                                ItemsSource="{Binding DataContext.TiposGrid, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                SelectedItem="{Binding tipo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEditable="True"/>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellEditTemplate>
                </telerik:GridViewDataColumn>

                <telerik:GridViewDataColumn Header="Ok"
                                    DataMemberBinding="{Binding ok}"
                                    Width="60"/>

                <telerik:GridViewDataColumn Header="F. Pgto."
                                    DataMemberBinding="{Binding forma_pagto}"
                                    Width="120"/>

                <telerik:GridViewDataColumn Header="Descrição"
                                    DataMemberBinding="{Binding descricao}"
                                    Width="250"/>

                <telerik:GridViewDataColumn Header="Detalhe"
                                    DataMemberBinding="{Binding detalhe_cartao}"
                                    Width="120"/>

                <telerik:GridViewDataColumn Header="CNPJ"
                                    DataMemberBinding="{Binding cnpj}"
                                    Width="140"/>

                <telerik:GridViewDataColumn Header="Data Emissão"
                                    DataMemberBinding="{Binding data_emissao}"
                                    DataFormatString="{}{0:dd/MM/yyyy}"
                                    Width="115"/>

                <telerik:GridViewDataColumn Header="Vencimento"
                                    DataMemberBinding="{Binding data_vencimento}"
                                    DataFormatString="{}{0:dd/MM/yyyy}"
                                    Width="115"/>

                <telerik:GridViewDataColumn Header="Pagamento"
                                    DataMemberBinding="{Binding data_pagamento}"
                                    DataFormatString="{}{0:dd/MM/yyyy}"
                                    Width="115"/>

                <telerik:GridViewDataColumn Header="Previsto"
                                    DataMemberBinding="{Binding valor_previsto}"
                                    DataFormatString="{}{0:N2}"
                                    TextAlignment="Right"
                                    Width="115"/>

                <telerik:GridViewDataColumn Header="Crédito"
                                    DataMemberBinding="{Binding credito}"
                                    DataFormatString="{}{0:N2}"
                                    TextAlignment="Right"
                                    Width="115"/>

                <telerik:GridViewDataColumn Header="Débito"
                                    DataMemberBinding="{Binding debito}"
                                    DataFormatString="{}{0:N2}"
                                    TextAlignment="Right"
                                    Width="115"/>

                <telerik:GridViewDataColumn Header="Saldo Acumulado"
                                    DataMemberBinding="{Binding saldo_acumulado}"
                                    DataFormatString="{}{0:N2}"
                                    TextAlignment="Right"
                                    Width="130"/>

                <telerik:GridViewDataColumn Header="Documento"
                                    DataMemberBinding="{Binding numero_documento}"
                                    Width="120"/>

                <telerik:GridViewDataColumn Header="Parcela"
                                    DataMemberBinding="{Binding parcela}"
                                    Width="80"/>

                <telerik:GridViewDataColumn Header="Razão Social"
                                    DataMemberBinding="{Binding razao_social}"
                                    Width="220"/>

                <telerik:GridViewDataColumn Header="Obs"
                                    DataMemberBinding="{Binding obs}"
                                    Width="220"/>

            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

    </Grid>

</UserControl>
