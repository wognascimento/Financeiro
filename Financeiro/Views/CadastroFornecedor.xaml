<UserControl x:Class="Financeiro.Views.CadastroFornecedor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="720"
             d:DesignWidth="1400">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,0,8,8"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style TargetType="telerik:RadWatermarkTextBox">
                    <Setter Property="Margin" Value="0,0,12,8"/>
                    <Setter Property="MinHeight" Value="26"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="ID"/>
            <telerik:RadWatermarkTextBox Grid.Column="1" IsReadOnly="True" Text="{Binding FornecedorAtual.idfornecedor, Mode=TwoWay}"/>

            <TextBlock Grid.Column="2" Text="CNPJ/CPF" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox x:Name="txtCnpjCpf" Grid.Column="3" Text="{Binding FornecedorAtual.cnpj_cpf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="CnpjCpf_LostFocus"/>

            <TextBlock Grid.Column="4" Text="Pessoa" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox Grid.Column="5" IsReadOnly="True" Text="{Binding FornecedorAtual.pessoa_j, Mode=TwoWay}"/>

            <TextBlock Grid.Row="1" Text="Razao Social"/>
            <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding FornecedorAtual.razao_social, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="4" Text="Nome Fantasia" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="5" Text="{Binding FornecedorAtual.nomefantasia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Text="CEP"/>
            <telerik:RadWatermarkTextBox x:Name="txtCep" Grid.Row="2" Grid.Column="1" Text="{Binding FornecedorAtual.cep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="Cep_LostFocus"/>

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Endereco" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox Grid.Row="2" Grid.Column="3" Text="{Binding FornecedorAtual.enderaco, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EnderecoSomenteLeitura}"/>

            <TextBlock Grid.Row="2" Grid.Column="4" Text="Numero" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox Grid.Row="2" Grid.Column="5" Text="{Binding FornecedorAtual.numero, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Text="Bairro"/>
            <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="1" Text="{Binding FornecedorAtual.bairro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EnderecoSomenteLeitura}"/>

            <TextBlock Grid.Row="3" Grid.Column="2" Text="Cidade" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="3" Text="{Binding FornecedorAtual.cidade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EnderecoSomenteLeitura}"/>

            <TextBlock Grid.Row="3" Grid.Column="4" Text="Estado" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="5" Text="{Binding FornecedorAtual.estado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EnderecoSomenteLeitura}"/>

            <TextBlock Grid.Row="4" Text="Complemento"/>
            <telerik:RadWatermarkTextBox Grid.Row="4" Grid.Column="1" Text="{Binding FornecedorAtual.complemento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Grid.Column="2" Text="Site" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox Grid.Row="4" Grid.Column="3" Text="{Binding FornecedorAtual.site, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Grid.Column="4" Text="Email" Margin="8,0,8,8"/>
            <telerik:RadWatermarkTextBox Grid.Row="4" Grid.Column="5" Text="{Binding FornecedorAtual.email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5" Text="Fone"/>
            <telerik:RadWatermarkTextBox Grid.Row="5" Grid.Column="1" Text="{Binding FornecedorAtual.fone1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <telerik:RadToolBar Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="3"
                                Margin="0,0,0,8"
                                GripVisibility="Collapsed"
                                OverflowButtonVisibility="Collapsed">
                <telerik:RadButton Content="Novo" Click="OnNovoClick" Padding="12,4"/>
                <telerik:RadButton Content="Gravar" Click="OnGravarClick" Padding="12,4"/>
            </telerik:RadToolBar>
        </Grid>

        <telerik:RadGridView x:Name="GridFornecedores"
                             Grid.Row="1"
                             Margin="0,18,0,0"
                             ItemsSource="{Binding Fornecedores}"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             IsReadOnly="True"
                             IsFilteringAllowed="True"
                             RowIndicatorVisibility="Collapsed"
                             SelectionMode="Single"
                             SelectionUnit="FullRow"
                             MouseDoubleClick="GridFornecedores_MouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding idfornecedor}" Width="80"/>
                <telerik:GridViewDataColumn Header="CNPJ/CPF" DataMemberBinding="{Binding cnpj_cpf}" Width="150"/>
                <telerik:GridViewDataColumn Header="RAZAO SOCIAL" DataMemberBinding="{Binding razao_social}" Width="260"/>
                <telerik:GridViewDataColumn Header="APELIDO" DataMemberBinding="{Binding nomefantasia}" Width="200"/>
                <telerik:GridViewDataColumn Header="E-MAIL" DataMemberBinding="{Binding email}" Width="220"/>
                <telerik:GridViewDataColumn Header="TELEFONE" DataMemberBinding="{Binding fone1}" Width="140"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
