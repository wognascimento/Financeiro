    <None Remove="icones\logo-cinza.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icones\logo-cinza.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.8" />
    <PackageReference Include="Telerik.UI.for.Wpf.80.Xaml" Version="2025.2.521" />
